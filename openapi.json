{
  "openapi": "3.1.0",
  "info": {
    "title": "JiStudio TikTok & TikTok Shop Apify Cloud API",
    "version": "2.1.0",
    "description": "Zero-cookie TikTok & TikTok Shop data extraction via Apify Store (https://apify.com/jistudio/tiktok-shop-scraper)."
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2",
      "description": "Apify Cloud REST API"
    }
  ],
  "paths": {
    "/acts/jistudio~tiktok-shop-scraper/run-sync-get-dataset-items": {
      "post": {
        "operationId": "runTikTokShopScraper",
        "summary": "Run TikTok & TikTok Shop Scraper synchronously and return clean JSON dataset items",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Apify API Token from https://console.apify.com/account/integrations"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "auto_start_urls", "video_no_watermark", "whisper_transcript",
                      "viral_algorithm_audit", "shop_product_detail", "shop_video_factory_pack",
                      "kol_shop_harvester", "shop_search", "search_videos", "user_profile",
                      "creator_feed", "video_comments", "trending_feed", "music_chart",
                      "live_shopping_spy", "national_keywords", "caption_genz_translator"
                    ]
                  },
                  "videoUrlOrId": { "type": "string" },
                  "productId": { "type": "string" },
                  "username": { "type": "string" },
                  "keyword": { "type": "string" },
                  "country": { "type": "string", "default": "VN" },
                  "maxItems": { "type": "integer", "default": 10 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Array of extracted TikTok / TikTok Shop records" }
        }
      }
    }
  }
}
